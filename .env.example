# =============================================================================
# UniFi Announcer — example configuration
# =============================================================================
# Copy this file to .env and keep the real .env private.
# Never commit credentials or include them in issue screenshots/logs.
#
# Protect 7.2.105 / Smart WiFi Chime firmware 1.7.20 validated credential path:
#   Protect -> Devices -> Smart WiFi Chime -> Settings -> Manage
#           -> Manual Recovery -> Reveal
# Use Reveal, not Edit. Edit changes the credential. See CREDENTIALS.md.
# =============================================================================

# --- UniFi Protect console ---
UNIFI_HOST=https://<your-unifi-console-host-or-ip>
UNIFI_USERNAME=<local-unifi-username>
UNIFI_PASSWORD=<local-unifi-password>
UNIFI_VERIFY_SSL=false

# --- Smart Chime ---
CHIME_ID=<protect-chime-id>
CHIME_DIRECT_IP=                   # optional; auto-discovered from Protect if empty
CHIME_DIRECT_USER=ubnt
# For arbitrary TTS, use the unique device password shown by Protect's
# Manual Recovery -> Reveal flow. Do not click Edit merely for Announcer setup.
# UniFi Announcer does not retrieve this credential automatically.
CHIME_DIRECT_PASSWORD=
# Optional refreshable secret-file provider; when set, it takes precedence over
# CHIME_DIRECT_PASSWORD and is re-read on file mtime change / direct HTTP 401.
CHIME_CREDENTIAL_FILE=
CHIME_VERIFY_SSL=false             # Smart Chime normally presents a self-signed certificate
DIRECT_TIMEOUT=8

# --- TTS ---
# Safe credential-free baseline. Set to piper or edge only after direct-device
# credential setup and /api/info verification described in CREDENTIALS.md.
TTS_ENGINE=none                    # none | piper | edge
PIPER_URL=tcp://<piper-host-or-ip>:10200
PIPER_VOICE=default
EDGE_TTS_VOICE=en-US-GuyNeural
TTS_RATE=1.0
TTS_SAMPLE_RATE=22050
TTS_ENCODER_PROFILE=mp3-mono-64k
TTS_TRIM_LEADING_SILENCE=false
TTS_CACHE_MAX_FILES=256
TTS_CACHE_MAX_BYTES=268435456      # 256 MiB

# --- API security ---
# Required for write routes and sensitive diagnostics.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=<generate-a-unique-secret>

# --- MCP (optional) ---
MCP_ENABLED=false
MCP_API_KEY=
MCP_ALLOWED_HOSTS=                 # comma-separated hostnames/IPs allowed by MCP Host validation

# --- Playback defaults (explicit volume=0 is honored) ---
VOLUME_DEFAULT=50                  # 0-100
REPEAT_DEFAULT=1                   # 1-6

# --- Quiet hours & volume profiles ---
# Suppress normal/info announcements during the window; doorbell/emergency
# still fire. Format "HH:MM-HH:MM", may cross midnight.
QUIET_HOURS=
# Named profiles referenced via {"profile": "night"} in requests:
VOLUME_PROFILES={"night": {"volume": 25}, "day": {"volume": 60}}

# --- Events ---
EVENTS_ENABLED=true                # websocket listener for doorbell events
EVENTS_BUFFER_MAX=100              # /events/recent ring-buffer size

# --- Multi-chime & groups (optional; default = single chime above) ---
# CHIMES_CONFIG=[{"name":"kitchen","id":"<uuid>","direct_ip":"<chime-ip>"}]
# GROUPS_CONFIG={"downstairs":["kitchen"],"whole_house":["kitchen"]}

# --- Playback arbitration / Protect capacity ---
PLAY_QUEUE_MAX_DEPTH=16            # per-chime queue cap; info-priority drops when full
# Dynamic TTS remains fixed at exactly two service-owned slots. Resident content
# is reused when the application can still prove the same slot/filename/device
# assignment, avoiding a flash overwrite for repeated phrases.
#
# These synchronization values guard the NEW-CONTENT write path only. Do not
# reduce them further without physical testing: concurrency, stale inventory,
# and wrong-audio protections depend on the bounded validation/settle window.
TTS_SLOT_SYNC_TIMEOUT=0.40          # seconds to prefer fresh Protect metadata after a direct write
TTS_SLOT_POLL_INTERVAL=0.10         # Protect speakerTrackList polling interval during that window
TTS_SLOT_SETTLE_DELAY=0.20          # final guard before Protect playback after a new physical write
TTS_SLOT_REUSE_MARGIN_MS=1250       # lease margin after estimated audio duration
TTS_SLOT_MIN_GUARD_MS=1750          # minimum lease before a slot may be overwritten again
# Deprecated in v2.1: dynamic TTS device usage is fixed at exactly two slots.
# Retained temporarily for legacy registry migration/startup compatibility.
MAX_DYNAMIC_TRACKS=32
# Protect capacity guard for provisioning the two service-owned TTS identities
# and persistent presets. Routine dynamic announcements create no new identities.
MAX_TOTAL_RINGTONES=6
DYNAMIC_SLOT_EXPERIMENT=false      # disconnected research scaffold; production slot manager is ownership-gated
UCP4_RESEARCH_ENABLED=false        # disconnected scaffold; no transport or command I/O

# --- MQTT bridge (optional; REST/SSE unaffected when unset) ---
MQTT_URL=                          # e.g. mqtt://<mqtt-host>:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Observability ---
DEBUG_TIMINGS=false                # X-Process-Time-ms header + timing logs on play routes
HEALTH_REFRESH_SECONDS=30          # background Protect health refresh; probes read cache only

# --- Service ---
APP_PORT=8095                      # container-internal port
HOST_PORT=8095                     # host-published port
CONTAINER_NAME=unifi-announcer
TZ=<your-timezone>                 # e.g. Area/City

# --- Paths (container-side) ---
# Empty uses a project-scoped Docker named volume. Existing installations may
# retain an absolute or relative bind path here to preserve their current data.
DATA_PATH=
PRESETS_DIR=/data/presets
CACHE_DIR=/data/cache              # + /tts = bounded content-addressed MP3 cache
DATA_DIR=/data                     # registries, installation identity, rules, and slot content proof live here

# --- Homepage integration ---
HOMEPAGE_GROUP=Utilities & Background Services
HOMEPAGE_NAME=UniFi Announcer
HOMEPAGE_ICON=mdi-bullhorn
HOMEPAGE_DESCRIPTION=TTS + preset tones on the UniFi chime
