# UniFi Announcer configuration — copy to .env and fill in
# All values parameterized; nothing secret committed to the repo.

# --- UniFi Protect controller ---
UNIFI_HOST=https://<unifi-host>
UNIFI_USERNAME=REPLACE_ME          # local UniFi OS account (not SSO)
UNIFI_PASSWORD=REPLACE_ME
UNIFI_VERIFY_SSL=false             # controller uses self-signed cert

# --- Chime target ---
CHIME_ID=REPLACE_ME                # UUID from GET /proxy/protect/api/chimes

# --- Smart Chime direct-device access ---
# v2.1.0 dynamic TTS uses two proven service-owned device slots and overwrites
# them in place. This direct write path requires a current per-device adoption
# credential maintained through an authorized external process. UniFi
# Announcer does not retrieve it, and there is no supported public retrieval
# workflow. Leave these values empty unless you already maintain the credential.
CHIME_DIRECT_IP=                   # optional; e.g. <chime-ip>; empty = NVR discovery
CHIME_DIRECT_USER=ubnt
CHIME_DIRECT_PASSWORD=
# Recommended for credentials maintained by an external local refresher: the
# file is re-read on mtime change and after an HTTP 401, without a container restart.
# CHIME_CREDENTIAL_FILE=/run/secrets/unifi_chime_password
CHIME_VERIFY_SSL=false             # chime uses self-signed cert

# --- Security ---
# API key required on all write/diagnostic routes when set (X-API-Key header).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# --- Optional MCP server ---
# Disabled by default. Uses a dedicated bearer key and the same listener as REST.
MCP_ENABLED=false
MCP_API_KEY=
# Comma-separated LAN hostnames/IPs clients will send in the Host header.
# Example: announcer.local,192.0.2.10
MCP_ALLOWED_HOSTS=

# --- TTS engine: "none" (safe baseline), "piper" (LAN), or "edge" (cloud) ---
TTS_ENGINE=none
PIPER_URL=tcp://<piper-host>:10200
PIPER_SYNTH_TIMEOUT=15             # seconds per synthesis attempt; reconnects once
PIPER_VOICE=default
TTS_RATE=1.0
TTS_SAMPLE_RATE=22050
TTS_ENCODER_PROFILE=mp3-mono-64k
TTS_TRIM_LEADING_SILENCE=false     # retains 15ms pre-roll when explicitly enabled
EDGE_TTS_VOICE=en-US-GuyNeural

# Dynamic speech is cached on the Announcer host but uses exactly two persistent
# service-owned Smart Chime slots. These limits bound the host MP3 cache only.
TTS_CACHE_MAX_FILES=256
TTS_CACHE_MAX_BYTES=268435456      # 256 MiB
# Advanced slot reuse guards. Normally leave these at defaults.
TTS_SLOT_REUSE_MARGIN_MS=1250
TTS_SLOT_MIN_GUARD_MS=1750
TTS_SLOT_PROVISION_TIMEOUT=15

# --- Playback defaults (explicit volume=0 is honored) ---
VOLUME_DEFAULT=50                  # 0-100
REPEAT_DEFAULT=1                   # 1-6

# --- Quiet hours & volume profiles ---
# Suppress normal/info announcements during the window; doorbell/emergency
# still fire. Format "HH:MM-HH:MM", may cross midnight.
QUIET_HOURS=
# Named profiles referenced via {"profile": "night"} in requests:
VOLUME_PROFILES={"night": {"volume": 25}, "day": {"volume": 60}}

# --- Events ---
EVENTS_ENABLED=true                # websocket listener for doorbell events
EVENTS_BUFFER_MAX=100              # /events/recent ring-buffer size

# --- Multi-chime & groups (optional; default = single chime above) ---
# CHIMES_CONFIG=[{"name":"kitchen","id":"<uuid>","direct_ip":"<chime-ip>"}]
# GROUPS_CONFIG={"downstairs":["kitchen"],"whole_house":["kitchen"]}

# --- Playback arbitration / Protect capacity ---
PLAY_QUEUE_MAX_DEPTH=16            # per-chime queue cap; info-priority drops when full
# Deprecated in v2.1: dynamic TTS device usage is fixed at exactly two slots.
# Retained temporarily for legacy registry migration/startup compatibility.
MAX_DYNAMIC_TRACKS=32
# Protect capacity guard for provisioning the two service-owned TTS identities
# and persistent presets. Routine dynamic announcements create no new identities.
MAX_TOTAL_RINGTONES=6
DYNAMIC_SLOT_EXPERIMENT=false      # disconnected research scaffold; production slot manager is ownership-gated
UCP4_RESEARCH_ENABLED=false        # disconnected scaffold; no transport or command I/O

# --- MQTT bridge (optional; REST/SSE unaffected when unset) ---
MQTT_URL=                          # e.g. mqtt://<mqtt-host>:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Observability ---
DEBUG_TIMINGS=false                # X-Process-Time-ms header + timing logs on play routes
HEALTH_REFRESH_SECONDS=30          # background Protect health refresh; probes read cache only

# --- Service ---
APP_PORT=8095                      # container-internal port
HOST_PORT=8095                     # host-published port
CONTAINER_NAME=unifi-announcer
TZ=<your-timezone>                 # e.g. Area/City

# --- Paths (container-side) ---
# Host-side persistent data path used by Docker Compose. The portable default is
# ./data beside docker-compose.yml. Set an absolute path for a NAS or server bind mount.
DATA_PATH=./data
PRESETS_DIR=/data/presets
CACHE_DIR=/data/cache              # + /tts = bounded content-addressed MP3 cache
DATA_DIR=/data                     # registries, installation identity, and rules live here

# --- Homepage integration ---
HOMEPAGE_GROUP=Utilities & Background Services
HOMEPAGE_NAME=UniFi Announcer
HOMEPAGE_ICON=mdi-bullhorn
HOMEPAGE_DESCRIPTION=TTS + preset tones on the UniFi chime