    "sensor": {
      "status": {"name": "Status"},
      "version": {"name": "Version"},
      "queue_depth": {"name": "Queue depth"},
      "last_disposition": {"name": "Last disposition"}
    }
  },
  "services": {
    "announce": {"name": "Announce", "description": "Speak text through a UniFi Announcer target."}
